+/* ===== Slideshow monitor ===== */
+.ss-head{margin-inline:auto;text-align:center}.ss-head .lead{margin-inline:auto}
+.ss .mon-screen{background:#1F1B1A}.ss-count{font-size:13px;font-weight:600;color:#4a3d3a;font-variant-numeric:tabular-nums;padding-right:6px}
+.ss-view{position:relative;aspect-ratio:16/10;overflow:hidden;background:#1F1B1A}
+.ss-slide{position:absolute;inset:0;margin:0;opacity:0;visibility:hidden;transition:opacity .9s ease,visibility .9s}
+.ss-slide.on{opacity:1;visibility:visible}
+.ss-slide img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transform:scale(1.001)}
+.ss-slide.on img{animation:ss-kb 7s ease-out both}
+@keyframes ss-kb{from{transform:scale(1.001)}to{transform:scale(1.07)}}
+.ss-slide::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(20,16,15,.82))}
+.ss-slide figcaption{position:absolute;z-index:1;left:0;right:0;bottom:0;padding:clamp(16px,3vw,32px);color:#fff}
+.ss-slide figcaption b{display:block;font-size:clamp(18px,2.6vw,30px);line-height:1.15}.ss-slide .chip{margin-bottom:8px;font-size:12px}
+.ss-nav{position:absolute;z-index:2;top:50%;width:44px;height:44px;margin-top:-22px;border:0;border-radius:50%;background:rgba(255,255,255,.88);color:#1F1B1A;font-size:26px;line-height:1;cursor:pointer;display:grid;place-items:center;opacity:0;transition:opacity .3s,transform .25s}
+.ss-prev{left:14px}.ss-next{right:14px}.ss-view:hover .ss-nav,.ss-nav:focus-visible{opacity:1}.ss-nav:hover{transform:scale(1.08)}
+@media(hover:none){.ss-nav{opacity:.9}}
+.ss-prog{position:absolute;z-index:2;left:0;right:0;bottom:0;height:3px;background:rgba(255,255,255,.22)}.ss-prog span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--glacier),var(--red))}
+.ss-ctl{display:flex;justify-content:center;margin-top:28px}
+@media(max-width:600px){.ss-nav{width:36px;height:36px;margin-top:-18px;font-size:22px}.ss-count{display:none}}
+@media(prefers-reduced-motion:reduce){.ss-slide.on img{animation:none}.ss-slide{transition:none}}
 @media(max-width:900px){.bento{grid-template-columns:repeat(2,1fr);grid-auto-rows:170px}.bento-i:nth-child(7n+6){grid-column:span 1}.fl1{left:0}.fl2{right:0}.fl3{left:0}}
