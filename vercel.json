{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "images": {
    "sizes": [
      640,
      960,
      1280,
      1920
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "localPatterns": [
      {
        "pathname": "^/assets/.*$"
      }
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "hebbkx1anhila5yf.public.blob.vercel-storage.com"
      }
    ]
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(theme.css|motion.css|motion.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/website",
      "destination": "/website-development",
      "permanent": true
    },
    {
      "source": "/social",
      "destination": "/social-media",
      "permanent": true
    },
    {
      "source": "/content",
      "destination": "/content-creation",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/our-work",
      "permanent": true
    }
  ]
}