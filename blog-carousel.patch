+/* ---------- Home: rotating Medium blog carousel ---------- */
+.blog-sec{background:radial-gradient(ellipse at 50% 100%,color-mix(in srgb,var(--glacier) 30%,transparent),transparent 65%),var(--card);overflow:hidden}
+.blog-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap}
+.bl{margin-top:48px;outline:none}
+.bl-stage{position:relative;height:620px;perspective:1600px;transform-style:preserve-3d}
+.bl-card{position:absolute;top:0;left:50%;width:min(520px,86vw);margin-left:calc(min(520px,86vw) / -2);display:flex;flex-direction:column;background:var(--bg);border:1px solid var(--line);border-radius:22px;overflow:hidden;text-decoration:none;color:var(--ink);box-shadow:0 30px 60px rgba(31,27,26,.16);transition:transform .9s cubic-bezier(.22,.8,.24,1),opacity .9s,filter .9s,box-shadow .3s;will-change:transform;backface-visibility:hidden}
+.bl-card[data-p="0"]{transform:translateX(0) translateZ(0) rotateY(0);z-index:3;opacity:1}
+.bl-card[data-p="1"]{transform:translateX(62%) translateZ(-260px) rotateY(-38deg);z-index:2;opacity:.75;filter:saturate(.7)}
+.bl-card[data-p="2"]{transform:translateX(-62%) translateZ(-260px) rotateY(38deg);z-index:2;opacity:.75;filter:saturate(.7)}
+.bl-card[data-p="0"]:hover{box-shadow:0 36px 70px rgba(31,27,26,.22)}
+.bl-card[data-p="0"]:hover .bl-go b{transform:translateX(5px)}
+.bl-card:not([data-p="0"]){cursor:pointer}
+.bl-bar{display:flex;align-items:center;gap:6px;padding:11px 16px;background:var(--forest-deep);color:var(--mut-on-dark);font-size:12px;letter-spacing:.04em}
+.bl-bar i{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,.28)}.bl-bar i:first-child{background:var(--red)}
+.bl-bar span{margin-left:10px;padding:2px 12px;border-radius:99px;background:rgba(255,255,255,.1)}
+.bl-img{position:relative;aspect-ratio:16/9;background:linear-gradient(135deg,var(--ice),var(--glacier));overflow:hidden}
+.bl-img img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.06);transition:transform 6s ease-out}
+.bl-card[data-p="0"] .bl-img img{transform:scale(1)}
+.bl-img em{position:absolute;left:16px;top:16px;font-style:normal;font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;background:var(--red);color:#fff;padding:5px 12px;border-radius:99px}
+.bl-body{padding:22px 26px 26px}
+.bl-body small{display:block;color:var(--mut);font-size:14px;margin-bottom:8px}
+.bl-body h3{margin:0 0 10px;font-size:clamp(20px,2.2vw,24px);line-height:1.25}
+.bl-body p{color:var(--mut);margin:0 0 16px;font-size:16px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
+.bl-go{font-weight:600;color:var(--red-ink)}.bl-go b{display:inline-block;transition:transform .25s}
+.bl-ctl{display:flex;align-items:center;justify-content:center;gap:18px;margin-top:8px}
+.bl-arr{width:46px;height:46px;border-radius:50%;border:1.5px solid var(--line);background:var(--bg);color:var(--ink);font-size:18px;cursor:pointer;transition:background .25s,color .25s,border-color .25s}
+.bl-arr:hover{background:var(--ink);color:var(--bg);border-color:var(--ink)}
+.bl-dots{display:flex;gap:10px}
+.bl-dot{width:44px;height:6px;padding:0;border:0;border-radius:99px;background:var(--line);overflow:hidden;cursor:pointer}
+.bl-dot span{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--glacier),var(--red))}
+.bl-dot.on span{width:100%}
+.bl.run .bl-dot.on span{width:0;animation:blfill var(--bl-ms,6500ms) linear forwards}
+.bl.paused .bl-dot.on span{animation-play-state:paused}
+@keyframes blfill{to{width:100%}}
+@media(max-width:860px){
+  .bl-stage{height:560px}
+  .bl-card[data-p="1"]{transform:translateX(30%) translateZ(-300px) rotateY(-30deg);opacity:.45}
+  .bl-card[data-p="2"]{transform:translateX(-30%) translateZ(-300px) rotateY(30deg);opacity:.45}
+}
+@media(max-width:520px){.bl-stage{height:520px}.bl-body{padding:18px 20px 22px}}
+@media(prefers-reduced-motion:reduce){.bl-card{transition:opacity .2s!important}.bl-card:not([data-p="0"]){opacity:0;pointer-events:none}.bl-card{transform:none!important}}
